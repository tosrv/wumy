# Copy to .env and fill with your Supabase project values.
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Site URL — canonical URLs / OG and the DOKU return URL
# VITE_SITE_URL=http://localhost:5173

# Setup steps: see README.md (run supabase/schema.sql once, enable Email auth).

# DOKU payments — server only — never prefix with VITE_
# DOKU_CLIENT_ID=
# DOKU_SECRET_KEY=
# DOKU_API_BASE=https://api-sandbox.doku.com   # or https://api.doku.com
# PUBLISH_PRICE_IDR=10000   # optional: override the Rp 99.000 publish fee (whole rupiah, >= 1000), e.g. for a production test
# SUPABASE_SERVICE_ROLE_KEY=

# Product analytics (PostHog, optional). Public project key; leave empty to disable.
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# Staging only (Vercel Preview / dev branch). Leave empty in production.
# STAGING_PASSWORD=        # server only: Basic Auth (user "wumy") for the whole site except the DOKU webhook
# VITE_APP_ENV=staging     # shows a small "Staging" label
